# ─── Placement Nexus AI Service — Environment Variable Reference ──────────────
#
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file with actual secrets.
#
# ─── Service Identity ─────────────────────────────────────────────────────────

NODE_ENV=development    # Set to "production" in deployed environments

# ─── Internal Auth ────────────────────────────────────────────────────────────

# Must match the backend's AI_INTERNAL_KEY.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AI_INTERNAL_KEY=CHANGE_ME_AI_INTERNAL_KEY

# ─── AI Provider ─────────────────────────────────────────────────────────────

# Which provider to use: "mock" (default, no external calls) or "gemini"
AI_PROVIDER=mock

# Gemini API Key (only required when AI_PROVIDER=gemini)
# Never expose this in the frontend or logs.
AI_GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
