// ============================================================================
// PLACEMENT NEXUS — MASTER DATABASE SCHEMA (PHASE 0)
// ============================================================================
// PostgreSQL + Prisma
// This file is the single source of truth for the data model.
// Conventions:
//   - Every table has: id (cuid), createdAt, updatedAt
//   - Foreign keys use onDelete behavior appropriate to ownership (see notes)
//   - JSONB used only where structure is genuinely variable (statistics, metadata)
//   - Enums used instead of free-text status columns wherever states are fixed
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. CORE IDENTITY & AUTH
// ============================================================================

enum UserRole {
  STUDENT
  RECRUITER
  PLACEMENT_OFFICER
  ALUMNI
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         UserRole
  status       AccountStatus @default(PENDING_VERIFICATION)

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // OTP-based verification (per project methodology requirement)
  otpCode      String?
  otpExpiresAt DateTime?
  otpPurpose   String? // "EMAIL_VERIFY" | "PASSWORD_RESET" | "LOGIN_2FA"

  refreshTokenHash   String? // current valid refresh token (hashed), rotated on use
  refreshTokenExpiry DateTime?

  passwordResetToken       String?
  passwordResetTokenExpiry DateTime?

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One-to-one profile per role — only the matching profile is ever populated
  student          Student?
  recruiter        Recruiter?
  placementOfficer PlacementOfficer?
  alumniProfile    AlumniProfile?

  notifications     Notification[]
  notificationPrefs NotificationPreference?
  auditLogsActed    AuditLog[]              @relation("AuditActor")

  @@index([role])
  @@index([status])
  @@map("users")
}

model PlacementOfficer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName    String
  designation String?
  department  String?
  phone       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("placement_officers")
}

// ============================================================================
// 2. STUDENT DOMAIN
// ============================================================================

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName        String
  rollNumber      String    @unique
  phone           String?
  dateOfBirth     DateTime?
  gender          String?
  address         String?
  profilePhotoUrl String?

  profileCompletionPct Int             @default(0)
  placementStatus      PlacementStatus @default(NOT_PLACED)

  academics            StudentAcademic?
  skills               StudentSkill[]
  projects             Project[]
  internships          Internship[]
  certifications       Certification[]
  achievements         Achievement[]
  codingProfiles       CodingProfile[]
  professionalProfiles ProfessionalProfile[]
  resumes              Resume[]

  assessmentAttempts AssessmentAttempt[]
  careerGoals        StudentCareerGoal[]
  skillGaps          SkillGap[]
  learningProgress   LearningProgress[]
  readinessScores    ReadinessScore[]

  applications       Application[]
  referralRequests   ReferralRequest[]
  mentorshipRequests MentorshipRequest[]
  mockInterviews     MockInterview[]

  resumeAnalyses        ResumeAnalysis[]
  careerRecommendations CareerRecommendation[]

  // Phase 15 back-relations
  driveExperiences DriveExperience[]
  driveResources   DriveResource[]

  // Alumni linkage: when a student graduates and becomes an alumnus, the
  // AlumniProfile references back to this record for provenance — never delete
  // the historical student record when an alumni account is created.
  alumniProfile AlumniProfile?

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  drivePreparationPlans DrivePreparationPlan[]

  @@index([placementStatus])
  @@map("students")
}

enum PlacementStatus {
  NOT_PLACED
  IN_PROCESS
  PLACED
  OPTED_OUT
}

model StudentAcademic {
  id        String  @id @default(cuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  degree            String // e.g. "B.Tech"
  branch            String // e.g. "CSE"
  collegeName       String
  graduationYear    Int
  cgpa              Decimal  @db.Decimal(4, 2)
  backlogs          Int      @default(0)
  tenthPercentage   Decimal? @db.Decimal(5, 2)
  twelfthPercentage Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branch, graduationYear])
  @@map("student_academics")
}

// Master skill catalog — shared across students, career paths, drives
model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String? // e.g. "Programming Language", "Framework", "Soft Skill"

  studentSkills        StudentSkill[]
  careerRequirements   CareerSkillRequirement[]
  driveRequiredSkills  DriveRequirement[]       @relation("RequiredSkill")
  drivePreferredSkills DriveRequirement[]       @relation("PreferredSkill")
  skillGaps            SkillGap[]
  learningResources    LearningResourceSkill[]
  preparationTasks     PreparationTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skills")
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model StudentSkill {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Restrict)

  selfRating    ProficiencyLevel
  // Evidence-backed, system-computed confidence (0-100), distinct from self-rating.
  // Populated by skill-gap engine using assessments + coding + projects.
  evidenceScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, skillId])
  @@map("student_skills")
}

model Project {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title       String
  description String
  techStack   String[] // simple text array; not normalized — low query need
  repoUrl     String?
  liveUrl     String?
  startDate   DateTime?
  endDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("projects")
}

model Internship {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  companyName    String
  role           String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  isOngoing      Boolean   @default(false)
  certificateUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("internships")
}

model Certification {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title         String
  issuingOrg    String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialUrl String?
  fileUrl       String? // uploaded PDF/image, via file storage abstraction

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("certifications")
}

model Achievement {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    String? // e.g. "Hackathon", "Publication", "Award"
  date        DateTime?
  proofUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("achievements")
}

enum SyncStatus {
  NOT_SYNCED
  SYNCING
  SYNCED
  FAILED
  MANUAL_ONLY
}

// Generic coding-platform integration — one model handles GitHub, LeetCode,
// CodeChef, HackerRank, Codeforces, GeeksforGeeks, and future platforms
// without schema changes. See master spec Section 5.
model CodingProfile {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  platform   String // "GITHUB" | "LEETCODE" | "CODECHEF" | "HACKERRANK" | "CODEFORCES" | "GFG" | ...
  username   String
  profileUrl String

  statistics   Json? // platform-specific shape, e.g. {"problemsSolved": 320, "rating": 1650}
  syncStatus   SyncStatus @default(NOT_SYNCED)
  lastSyncedAt DateTime?
  syncError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, platform])
  @@map("coding_profiles")
}

model ProfessionalProfile {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  platform   String // "LINKEDIN" | future platforms
  profileUrl String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, platform])
  @@map("professional_profiles")
}

model Resume {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  fileUrl       String // storage reference, not the binary itself
  fileName      String
  fileSizeBytes Int
  isPrimary     Boolean @default(false)

  analyses ResumeAnalysis[]

  uploadedAt DateTime @default(now())

  @@index([studentId])
  @@map("resumes")
}

// ============================================================================
// 3. ASSESSMENT ENGINE (reusable across Aptitude / Technical / Coding)
// ============================================================================

enum AssessmentCategory {
  APTITUDE
  TECHNICAL
  CODING
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Assessment {
  id             String             @id @default(cuid())
  title          String
  description    String?
  category       AssessmentCategory
  topic          String // e.g. "DBMS", "DSA", "Quantitative Ability" — configurable, not enum
  difficulty     String? // "EASY" | "MEDIUM" | "HARD" — free text to stay configurable
  durationMins   Int
  passPercentage Int?
  status         AssessmentStatus   @default(DRAFT)

  createdById String // Placement Officer who created it
  questions   Question[]
  attempts    AssessmentAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, topic])
  @@map("assessments")
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTIPLE
  CODING
  DESCRIPTIVE
}

model Question {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  type       QuestionType
  text       String
  topic      String? // topic-level tagging for topic-wise performance analytics
  difficulty String?
  marks      Int          @default(1)

  // For CODING type only:
  starterCode String?
  testCases   Json? // [{input, expectedOutput, isHidden}]

  options QuestionOption[]
  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String
  isCorrect Boolean @default(false)

  answers Answer[] @relation("SelectedOption")

  @@index([questionId])
  @@map("question_options")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  EXPIRED
}

model AssessmentAttempt {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  timeTakenSecs Int?

  answers Answer[]
  result  AssessmentResult?

  @@index([studentId])
  @@index([assessmentId])
  @@map("assessment_attempts")
}

model Answer {
  id         String            @id @default(cuid())
  attemptId  String
  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId String?
  selectedOption   QuestionOption? @relation("SelectedOption", fields: [selectedOptionId], references: [id])
  freeTextAnswer   String? // for DESCRIPTIVE / CODING submissions
  isCorrect        Boolean?
  marksAwarded     Int?

  createdAt DateTime @default(now())

  @@unique([attemptId, questionId])
  @@map("answers")
}

model AssessmentResult {
  id        String            @id @default(cuid())
  attemptId String            @unique
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  totalMarks     Int
  scoredMarks    Int
  percentage     Decimal  @db.Decimal(5, 2)
  percentile     Decimal? @db.Decimal(5, 2)
  topicBreakdown Json // {"Graphs": 40, "Trees": 60, "DP": 30} — % per topic

  createdAt DateTime @default(now())

  @@map("assessment_results")
}

// ============================================================================
// 4. CAREER DEVELOPMENT, SKILL GAP, READINESS
// ============================================================================

model CareerPath {
  id          String  @id @default(cuid())
  name        String  @unique // "Software Engineer", "Data Analyst", ...
  description String?
  isActive    Boolean @default(true)

  skillRequirements     CareerSkillRequirement[]
  studentGoals          StudentCareerGoal[]
  readinessScores       ReadinessScore[]
  careerRecommendations CareerRecommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("career_paths")
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model CareerSkillRequirement {
  id           String     @id @default(cuid())
  careerPathId String
  careerPath   CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Restrict)

  requiredLevel ProficiencyLevel
  priority      RequirementPriority @default(MEDIUM)

  @@unique([careerPathId, skillId])
  @@map("career_skill_requirements")
}

model StudentCareerGoal {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careerPathId String
  careerPath   CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([studentId, careerPathId])
  @@map("student_career_goals")
}

enum GapLevel {
  STRONG
  MODERATE
  WEAK
  MISSING
}

// Skill Gap is intentionally evidence-carrying, not just a label — see
// master spec Section 8: "DSA = 48%, weak topics = Graphs/Trees/DP" pattern.
model SkillGap {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  gapLevel            GapLevel
  evidenceScore       Int // 0-100, computed from assessments + coding + projects
  priority            RequirementPriority
  contributingFactors Json // {"assessmentPct": 52, "codingActivity": "moderate", "weakTopics": ["Graphs","Trees"]}

  computedAt DateTime @default(now())

  @@unique([studentId, skillId])
  @@index([studentId, gapLevel])
  @@map("skill_gaps")
}

model LearningResource {
  id           String  @id @default(cuid())
  title        String
  description  String?
  resourceType String // "VIDEO" | "ARTICLE" | "COURSE" | "DOCUMENTATION" | ...
  url          String
  provider     String? // "YouTube", "Coursera", internal upload, etc.

  skills           LearningResourceSkill[]
  learningPaths    LearningPathResource[]
  preparationTasks PreparationTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("learning_resources")
}

model LearningResourceSkill {
  id                 String           @id @default(cuid())
  learningResourceId String
  learningResource   LearningResource @relation(fields: [learningResourceId], references: [id], onDelete: Cascade)
  skillId            String
  skill              Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([learningResourceId, skillId])
  @@map("learning_resource_skills")
}

model LearningPath {
  id        String @id @default(cuid())
  studentId String
  title     String // e.g. "Close my DSA gap for Software Engineer track"

  resources LearningPathResource[]
  progress  LearningProgress[]
  tasks     PreparationTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("learning_paths")
}

model LearningPathResource {
  id                 String           @id @default(cuid())
  learningPathId     String
  learningPath       LearningPath     @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  learningResourceId String
  learningResource   LearningResource @relation(fields: [learningResourceId], references: [id], onDelete: Cascade)
  orderIndex         Int

  @@unique([learningPathId, learningResourceId])
  @@map("learning_path_resources")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LearningProgress {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  learningPathId String
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  status        ProgressStatus @default(NOT_STARTED)
  completionPct Int            @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([studentId, learningPathId])
  @@map("learning_progress")
}

// Readiness is deliberately separate per career path AND optionally per drive.
// Never merged with Eligibility or JobMatch — see master spec Section 11.
model ReadinessScore {
  id               String          @id @default(cuid())
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careerPathId     String?
  careerPath       CareerPath?     @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  placementDriveId String?
  placementDrive   PlacementDrive? @relation(fields: [placementDriveId], references: [id], onDelete: Cascade)

  // null careerPathId + null placementDriveId = OVERALL readiness score
  overallScore Int // 0-100
  breakdown    Json // {"strengths": [...], "weaknesses": [...], "priorities": [...]}

  computedAt DateTime @default(now())

  @@index([studentId])
  @@map("readiness_scores")
}

model DrivePreparationPlan {
  id               String         @id @default(cuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  placementDriveId String
  placementDrive   PlacementDrive @relation(fields: [placementDriveId], references: [id], onDelete: Cascade)

  progressPct Int               @default(0)
  tasks       PreparationTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, placementDriveId])
  @@map("drive_preparation_plans")
}

model PreparationTask {
  id                     String                @id @default(cuid())
  drivePreparationPlanId String?
  drivePreparationPlan   DrivePreparationPlan? @relation(fields: [drivePreparationPlanId], references: [id], onDelete: Cascade)
  learningPathId         String?
  learningPath           LearningPath?         @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  title    String
  category String? // "APTITUDE", "CODING", "HR", "RESUME"
  status   ProgressStatus @default(NOT_STARTED)

  driveResourceId    String?
  driveResource      DriveResource?    @relation(fields: [driveResourceId], references: [id], onDelete: SetNull)
  driveExperienceId  String?
  driveExperience    DriveExperience?  @relation(fields: [driveExperienceId], references: [id], onDelete: SetNull)
  learningResourceId String?
  learningResource   LearningResource? @relation(fields: [learningResourceId], references: [id], onDelete: SetNull)
  skillId            String?
  skill              Skill?            @relation(fields: [skillId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("preparation_tasks")
}

// ============================================================================
// 5. COMPANIES, RECRUITERS
// ============================================================================

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyRole {
  COMPANY_ADMIN
  RECRUITER
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Company {
  id           String        @id @default(cuid())
  name         String
  legalName    String?
  website      String?
  industry     String?
  companyType  String?
  description  String?
  headquarters String?
  country      String?
  state        String?
  city         String?
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  companySize  String?
  foundedYear  Int?
  status       CompanyStatus @default(ACTIVE)

  recruiters      Recruiter[]
  memberships     RecruiterCompanyMembership[]
  verification    CompanyVerification?
  placementDrives PlacementDrive[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("companies")
}

model CompanyVerification {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  status          VerificationStatus @default(PENDING)
  verifiedById    String? // Placement Officer's User.id
  verifiedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_verifications")
}

model Recruiter {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  fullName       String
  designation    String?
  department     String?
  phone          String?
  alternateEmail String?

  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionReason    String?

  memberships     RecruiterCompanyMembership[]
  placementDrives PlacementDrive[]
  interviews      Interview[]                  @relation("Interviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  @@map("recruiters")
}

model RecruiterCompanyMembership {
  id          String    @id @default(cuid())
  recruiterId String
  recruiter   Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  role            CompanyRole      @default(RECRUITER)
  status          MembershipStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recruiterId, companyId])
  @@index([companyId])
  @@index([recruiterId])
  @@index([status])
  @@map("recruiter_company_memberships")
}

// ============================================================================
// 6. PLACEMENT DRIVES, APPLICATIONS, INTERVIEWS
// ============================================================================

enum DriveStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  CLOSED
  CANCELLED
  COMPLETED
}

model PlacementDrive {
  id                   String    @id @default(cuid())
  companyId            String
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdByRecruiterId String
  createdByRecruiter   Recruiter @relation(fields: [createdByRecruiterId], references: [id], onDelete: Restrict)

  title          String
  jobTitle       String
  description    String
  employmentType String @default("FULL_TIME") // FULL_TIME, PART_TIME, INTERNSHIP
  jobType        String @default("TECHNICAL") // TECHNICAL, NON_TECHNICAL
  location       String
  workMode       String @default("ONSITE") // ONSITE, REMOTE, HYBRID

  salaryMin      Decimal? @db.Decimal(12, 2)
  salaryMax      Decimal? @db.Decimal(12, 2)
  salaryCurrency String   @default("INR")
  salaryPeriod   String   @default("YEARLY")

  openingCount   Int?
  graduationYear Int?

  applicationStartAt DateTime
  applicationEndAt   DateTime
  driveDate          DateTime?

  selectionProcess String? // free text summary; rounds detail lives in DriveExperience/Interview

  status DriveStatus @default(DRAFT)

  requirements          DriveRequirement?
  applications          Application[]
  readinessScores       ReadinessScore[]
  driveExperiences      DriveExperience[]
  driveResources        DriveResource[]
  referralOpportunities ReferralOpportunity[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  drivePreparationPlans DrivePreparationPlan[]

  @@index([status])
  @@map("placement_drives")
}

model DriveRequirement {
  id               String         @id @default(cuid())
  placementDriveId String         @unique
  placementDrive   PlacementDrive @relation(fields: [placementDriveId], references: [id], onDelete: Cascade)

  minCgpa            Decimal? @db.Decimal(4, 2)
  maxCgpa            Decimal? @db.Decimal(4, 2)
  allowedBranches    String[]
  allowedDegrees     String[]
  maxActiveBacklogs  Int?
  maxHistoryBacklogs Int?
  minGraduationYear  Int?
  maxGraduationYear  Int?

  requireInternship Boolean @default(false)

  requiredSkills  Skill[] @relation("RequiredSkill")
  preferredSkills Skill[] @relation("PreferredSkill")

  @@map("drive_requirements")
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  ASSESSMENT_STAGE
  INTERVIEW_STAGE
  SELECTED
  REJECTED
  WITHDRAWN
}

model Application {
  id               String         @id @default(cuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  placementDriveId String
  placementDrive   PlacementDrive @relation(fields: [placementDriveId], references: [id], onDelete: Cascade)

  status          ApplicationStatus @default(APPLIED)
  // Snapshot at application time — job match/eligibility can be recomputed,
  // but the recruiter should see what was true when the student applied.
  jobMatchPct     Int?
  eligibleAtApply Boolean

  interviews Interview[]
  selection  Selection?

  // Phase 15: an experience can optionally be linked to a specific application for provenance
  driveExperience DriveExperience?

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, placementDriveId])
  @@index([placementDriveId, status])
  @@map("applications")
}

enum InterviewType {
  APTITUDE
  TECHNICAL
  CODING
  HR
  MANAGERIAL
  OTHER
}

enum InterviewOutcome {
  PENDING
  PASSED
  FAILED
  NO_SHOW
}

model Interview {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId String
  interviewer   Recruiter   @relation("Interviewer", fields: [interviewerId], references: [id], onDelete: Restrict)

  roundNumber Int
  type        InterviewType
  scheduledAt DateTime
  meetingLink String?
  location    String?

  outcome  InterviewOutcome @default(PENDING)
  feedback String?
  score    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@map("interviews")
}

enum SelectionDecision {
  SELECTED
  REJECTED
}

model Selection {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  decision     SelectionDecision
  finalPackage Decimal?          @db.Decimal(12, 2)
  decidedAt    DateTime          @default(now())
  notes        String?

  @@map("selections")
}

// ============================================================================
// 7. ALUMNI: PROFILE, VERIFICATION, REFERRALS, EXPERIENCES, RESOURCES, MENTORSHIP
// ============================================================================

model AlumniProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Provenance link back to original student record where available.
  // Nullable because some alumni may predate the platform / register directly.
  studentId String?  @unique
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  fullName       String
  degree         String
  branch         String
  graduationYear Int
  collegeName    String

  currentCompany  String?
  currentRole     String?
  yearsExperience Int?
  skills          String[]
  linkedinUrl     String?

  verification AlumniVerification?
  // Mentorship (Phase 16)
  isMentor     Boolean             @default(false)
  mentorBio    String?
  mentorTopics String[] // e.g., ["Mock Interviews", "Resume Review", "Career Advice"]
  maxMentees   Int                 @default(3)

  referralOpportunities ReferralOpportunity[]
  driveExperiences      DriveExperience[]
  driveResources        DriveResource[]
  referralRequests      ReferralRequest[]
  mentorshipRequests    MentorshipRequest[]
  mentorshipSessions    MentorshipSession[]
  mockInterviews        MockInterview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("alumni_profiles")
}

model AlumniVerification {
  id              String        @id @default(cuid())
  alumniProfileId String        @unique
  alumniProfile   AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  status          VerificationStatus @default(PENDING)
  verifiedById    String? // Placement Officer's User.id
  verifiedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("alumni_verifications")
}

// Only VERIFIED alumni may create these — enforced at service layer, not DB,
// since the DB has no clean way to express "verification.status == APPROVED".
model ReferralOpportunity {
  id               String          @id @default(cuid())
  alumniProfileId  String
  alumniProfile    AlumniProfile   @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)
  placementDriveId String? // optional link if it corresponds to an active drive
  placementDrive   PlacementDrive? @relation(fields: [placementDriveId], references: [id], onDelete: SetNull)

  companyName    String
  role           String
  location       String?
  requiredSkills String[]
  experienceReq  String?
  description    String
  deadline       DateTime?

  isActive Boolean @default(true)

  referralRequests ReferralRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([alumniProfileId])
  @@map("referral_opportunities")
}

enum ReferralStatus {
  REQUESTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  REFERRED
  APPLICATION_SUBMITTED
}

model ReferralRequest {
  id                    String              @id @default(cuid())
  studentId             String
  student               Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  referralOpportunityId String
  referralOpportunity   ReferralOpportunity @relation(fields: [referralOpportunityId], references: [id], onDelete: Cascade)

  status         ReferralStatus @default(REQUESTED)
  studentMessage String?
  alumniResponse String?

  referral Referral?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  alumniProfile   AlumniProfile? @relation(fields: [alumniProfileId], references: [id])
  alumniProfileId String?

  @@unique([studentId, referralOpportunityId])
  @@map("referral_requests")
}

// Separate audit-style record of the actual referral action, so a student
// cannot fabricate "I was referred" — only created when alumni action fires it.
model Referral {
  id                String          @id @default(cuid())
  referralRequestId String          @unique
  referralRequest   ReferralRequest @relation(fields: [referralRequestId], references: [id], onDelete: Cascade)

  referredAt DateTime @default(now())
  proofNote  String? // e.g. internal reference ID given by alumni

  @@map("referrals")
}

// Phase 15 — Experience and Resource status/category enums
enum ExperienceStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ExperienceDifficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum ExperienceOutcome {
  SELECTED
  REJECTED
  WAITLISTED
  PREFER_NOT_TO_SAY
}

enum ResourceCategory {
  APTITUDE
  CODING
  TECHNICAL
  HR
  RESUME
  COMPANY_PREP
  DRIVE_PREP
  OTHER
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model DriveExperience {
  id               String          @id @default(cuid())
  // Author: either an alumni or a student (exactly one must be set — enforced at service layer)
  alumniProfileId  String?
  alumniProfile    AlumniProfile?  @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)
  studentId        String?
  student          Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  placementDriveId String?
  placementDrive   PlacementDrive? @relation(fields: [placementDriveId], references: [id], onDelete: SetNull)
  applicationId    String?         @unique // optional link to a specific application for provenance
  application      Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  companyName String
  role        String
  driveYear   Int

  difficulty    ExperienceDifficulty?
  outcome       ExperienceOutcome     @default(PREFER_NOT_TO_SAY)
  isAnonymous   Boolean               @default(false) // author explicitly chose to hide identity
  overallRating Int? // 1-5
  overallTips   String?
  narrative     String? // main free-form experience write-up

  rounds           ExperienceRound[]
  preparationTasks PreparationTask[]

  status          ExperienceStatus @default(PENDING)
  moderatedById   String? // Officer User.id
  moderatedAt     DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName])
  @@index([status])
  @@index([alumniProfileId])
  @@index([studentId])
  @@map("drive_experiences")
}

model ExperienceRound {
  id                String          @id @default(cuid())
  driveExperienceId String
  driveExperience   DriveExperience @relation(fields: [driveExperienceId], references: [id], onDelete: Cascade)

  roundNumber    Int
  roundType      InterviewType
  topics         String[]
  difficulty     String?
  questionsAsked String?
  tips           String?

  @@index([driveExperienceId])
  @@map("experience_rounds")
}

model DriveResource {
  id               String          @id @default(cuid())
  // Author: either an alumni or a student (exactly one must be set — enforced at service layer)
  alumniProfileId  String?
  alumniProfile    AlumniProfile?  @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)
  studentId        String?
  student          Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  placementDriveId String?
  placementDrive   PlacementDrive? @relation(fields: [placementDriveId], references: [id], onDelete: SetNull)

  companyName  String?
  roundType    InterviewType?
  category     ResourceCategory @default(OTHER)
  resourceType String // "LINK" | "PDF" | "VIDEO" | "ARTICLE" | "GUIDE"
  title        String
  description  String?
  fileUrl      String?
  externalUrl  String?

  preparationTasks PreparationTask[]

  status          ResourceStatus @default(PENDING)
  moderatedById   String? // Officer User.id
  moderatedAt     DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName])
  @@index([status])
  @@index([category])
  @@index([alumniProfileId])
  @@index([studentId])
  @@map("drive_resources")
}

enum MentorshipStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

model MentorshipRequest {
  id              String        @id @default(cuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  alumniProfileId String
  alumniProfile   AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  message String?
  status  MentorshipStatus @default(REQUESTED)

  session   MentorshipSession?
  guidances MentorGuidance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mentorship_requests")
}

model MentorshipSession {
  id                  String            @id @default(cuid())
  mentorshipRequestId String            @unique
  mentorshipRequest   MentorshipRequest @relation(fields: [mentorshipRequestId], references: [id], onDelete: Cascade)
  alumniProfileId     String
  alumniProfile       AlumniProfile     @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  meetingLink String?
  notes       String?
  feedback    String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mentorship_sessions")
}

model MentorGuidance {
  id                  String            @id @default(cuid())
  mentorshipRequestId String
  mentorshipRequest   MentorshipRequest @relation(fields: [mentorshipRequestId], references: [id], onDelete: Cascade)
  authorId            String // User.id of the person who wrote it
  content             String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mentorshipRequestId])
  @@map("mentor_guidance")
}

model MockInterview {
  id              String        @id @default(cuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  alumniProfileId String
  alumniProfile   AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  meetingLink String?
  targetRole  String?

  feedback MockInterviewFeedback?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mock_interviews")
}

model MockInterviewFeedback {
  id              String        @id @default(cuid())
  mockInterviewId String        @unique
  mockInterview   MockInterview @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade)

  strengths     String?
  weaknesses    String?
  overallScore  Int?
  detailedNotes String?

  createdAt DateTime @default(now())

  @@map("mock_interview_feedback")
}

// ============================================================================
// 8. NOTIFICATIONS
// ============================================================================

enum NotificationType {
  NEW_DRIVE
  APPLICATION_STATUS
  SHORTLISTED
  INTERVIEW_SCHEDULED
  ASSESSMENT_ASSIGNED
  REFERRAL_STATUS
  MENTORSHIP_UPDATE
  LEARNING_RECOMMENDATION
  SKILL_GAP_REMINDER
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  title    String
  message  String
  channel  NotificationChannel @default(IN_APP)
  isRead   Boolean             @default(false)
  metadata Json? // e.g. {"applicationId": "..."} for deep-linking

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEnabled  Boolean @default(true)
  inAppEnabled  Boolean @default(true)
  // per-type overrides stored as JSONB to avoid a column-per-type explosion
  typeOverrides Json?

  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// ============================================================================
// 9. AUDIT LOG
// ============================================================================

model AuditLog {
  id          String  @id @default(cuid())
  actorUserId String?
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String // e.g. "RECRUITER_APPROVED", "DRIVE_CREATED", "CANDIDATE_SELECTED"
  entityType String // e.g. "Recruiter", "PlacementDrive"
  entityId   String
  metadata   Json? // before/after or contextual details

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ============================================================================
// 10. AI-DERIVED DATA
// ============================================================================

enum ResumeAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ResumeAnalysis {
  id        String  @id @default(cuid())
  resumeId  String
  resume    Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status          ResumeAnalysisStatus @default(PENDING)
  atsScore        Int?
  extractedSkills String[]
  missingSections String[]
  keywordAnalysis Json?
  suggestions     Json? // structured list of improvement suggestions

  // Explicit flag so frontend can visually separate verified data from AI
  // inference — required by master spec Section 28.
  isAiGenerated Boolean @default(true)

  requestedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([studentId])
  @@map("resume_analyses")
}

model CareerRecommendation {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careerPathId String
  careerPath   CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)

  matchScore    Int // AI-computed suitability, 0-100
  reasoning     String?
  isAiGenerated Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("career_recommendations")
}
