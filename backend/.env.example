# ─── Placement Nexus Backend — Environment Variable Reference ─────────────────
#
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file with actual secrets.
# All secrets must be sourced from a secret manager in production.
#
# ─── Database ────────────────────────────────────────────────────────────────

# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/placement_nexus?schema=public"

# ─── Server ──────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development     # Set to "production" in deployed environments

# ─── CORS ────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins.
# In production, set to the exact deployed frontend URL, e.g.:
# CORS_ORIGIN=https://placementnexus.example.com
CORS_ORIGIN=http://localhost:5173

# ─── JWT ─────────────────────────────────────────────────────────────────────

# Access token secret — 64+ random hex characters recommended.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARS

# Refresh token secret — must be DIFFERENT from access token secret.
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_64_HEX_CHARS

# Token expiry (use JWT duration notation: "15m", "7d", etc.)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── AI Service ──────────────────────────────────────────────────────────────

# Internal service-to-service key used by Express to call the FastAPI AI service.
# Set in BOTH backend/.env AND ai-service/.env.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_INTERNAL_KEY=CHANGE_ME_AI_INTERNAL_KEY

# URL of the AI service (internal only)
AI_SERVICE_URL=http://localhost:8000
